@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gym Assistant | Registro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        /* Usamos @@ para que Razor no se confunda */
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background-color: #0F172A;
            color: #E2E8F0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background-color: #1E293B;
            border: 1px solid #334155;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
        }

        .input-field {
            background-color: #0F172A;
            border: 1px solid #334155;
            color: #E2E8F0;
            transition: border-color 0.2s;
        }

            .input-field:focus {
                border-color: #6366F1;
                outline: none;
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
            }

        .btn-primary {
            background-color: #4F46E5;
            color: white;
            transition: all 0.2s;
        }

            .btn-primary:hover:not(:disabled) {
                background-color: #4338CA;
                transform: translateY(-1px);
            }

        .shake {
            animation: shake 0.5s;
        }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-5px);
            }

            75% {
                transform: translateX(5px);
            }
        }
    </style>
</head>
<body>

    <div id="register-card" class="login-card p-8 sm:p-10 rounded-xl w-full max-w-md mx-4">
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-indigo-900/50 mb-4">
                <i data-lucide="user-plus" class="w-8 h-8 text-indigo-400"></i>
            </div>
            <h1 class="text-3xl font-bold text-white mb-2">Crear Cuenta</h1>
            <p class="text-slate-400 text-sm">Únete para empezar tu transformación</p>
        </div>

        <form id="register-form" onsubmit="handleRegister(event)">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1.5 text-slate-300">Nombre Completo</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-lucide="user" class="w-5 h-5 text-slate-500"></i>
                        </div>
                        <input type="text" id="nombre" required class="input-field w-full pl-10 p-3 rounded-lg" placeholder="Ej: Juan Pérez">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-1.5 text-slate-300">Correo Electrónico</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-lucide="mail" class="w-5 h-5 text-slate-500"></i>
                        </div>
                        <input type="email" id="email" required class="input-field w-full pl-10 p-3 rounded-lg" placeholder="juan@ejemplo.com">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-1.5 text-slate-300">Contraseña</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i data-lucide="lock" class="w-5 h-5 text-slate-500"></i>
                        </div>
                        <input type="password" id="password" required class="input-field w-full pl-10 p-3 rounded-lg" placeholder="••••••••">
                    </div>
                </div>
            </div>

            <div id="error-msg" class="hidden mt-4 p-3 bg-red-500/10 border border-red-500/50 rounded-lg flex items-center gap-2 text-red-200 text-sm">
                <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
                <span id="error-text">Error</span>
            </div>

            <button id="btn-submit" type="submit" class="btn-primary w-full mt-8 py-3 rounded-xl font-semibold flex items-center justify-center shadow-lg shadow-indigo-500/20">
                <i data-lucide="arrow-right" class="w-5 h-5 mr-2"></i>
                <span>Registrarse</span>
            </button>
        </form>

        <div class="mt-8 text-center border-t border-slate-700 pt-6">
            <p class="text-sm text-slate-400">¿Ya tienes cuenta?</p>
            <a href="/Auth/Login" class="text-sm font-semibold text-indigo-400 hover:text-indigo-300 transition">
                Inicia Sesión aquí
            </a>
        </div>
    </div>

    <script>
        async function handleRegister(event) {
            event.preventDefault();
            const nombre = document.getElementById('nombre').value;
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const btn = document.getElementById('btn-submit');
            const errorDiv = document.getElementById('error-msg');
            const errorText = document.getElementById('error-text');

            btn.disabled = true;
            btn.innerHTML = 'Procesando...';
            errorDiv.classList.add('hidden');

            try {
                const response = await fetch('/api/Auth/registrar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nombre, email, password })
                });

                if (response.ok) {
                    btn.innerHTML = '¡Éxito!';
                    btn.classList.replace('bg-indigo-600', 'bg-green-600');

                    // REDIRECCIÓN AL LOGIN (Como pediste)
                    setTimeout(() => { window.location.href = '/Auth/Login'; }, 1000);
                } else {
                    const errorMsg = await response.text();
                    throw new Error(errorMsg || 'Error al registrar.');
                }
            } catch (error) {
                errorText.textContent = error.message.replace(/"/g, '');
                errorDiv.classList.remove('hidden');
                document.getElementById('register-card').classList.add('shake');
                setTimeout(() => document.getElementById('register-card').classList.remove('shake'), 500);
                btn.disabled = false;
                btn.innerHTML = 'Registrarse';
                lucide.createIcons();
            }
        }
        window.onload = function() { lucide.createIcons(); };
    </script>
</body>
</html>