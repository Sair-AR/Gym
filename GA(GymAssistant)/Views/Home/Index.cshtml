@{
    ViewData["Title"] = "Home Page";
}
<style>
    main {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
    }
</style>
<!-- Hero Section -->
<section class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1>TRANSFORMA TU<br><span class="gradient-text">CUERPO Y MENTE</span></h1>
        <p>Entrena con los mejores. Alcanza tus metas. Supera tus límites.</p>
        <div class="hero-buttons">
            <a href="#contact" class="btn btn-primary">Prueba Gratis 7 Días</a>
            <a href="#pricing" class="btn btn-outline">Ver Planes</a>
            <a href="#" class="btn btn-outline">Crea tus Rutinas</a>
        </div>
    </div>
</section>

<!-- Services Section -->
<section class="services" id="services">
    <div class="container">
        <div class="section-header">
            <h2>Nuestros Servicios</h2>
            <p>Todo lo que necesitas para tu transformación</p>
        </div>
        <div class="services-grid">
            <div class="service-card">
                <i class="fas fa-dumbbell"></i>
                <h3>Entrenamiento Personal</h3>
                <p>Planes personalizados con entrenadores certificados para alcanzar tus objetivos</p>
            </div>
            <div class="service-card">
                <i class="fas fa-users"></i>
                <h3>Clases Grupales</h3>
                <p>Yoga, CrossFit, Spinning, Zumba y más. Entrena con energía grupal</p>
            </div>
            <div class="service-card">
                <i class="fas fa-trophy"></i>
                <h3>Nutrición Deportiva</h3>
                <p>Asesoría nutricional profesional para complementar tu entrenamiento</p>
            </div>
        </div>
    </div>
</section>

<!-- Pricing Section -->
<section class="pricing" id="pricing">
    <div class="container">
        <div class="section-header">
            <h2>Planes de Membresía</h2>
            <p>Elige el plan perfecto para ti</p>
        </div>
        <div class="pricing-grid">
            <div class="pricing-card">
                <h3>Básico</h3>
                <div class="price">
                    <span class="amount">$39</span>
                    <span class="period">/mes</span>
                </div>
                <ul class="features">
                    <li><i class="fas fa-clock"></i> Acceso ilimitado</li>
                    <li><i class="fas fa-dumbbell"></i> Área de pesas y cardio</li>
                    <li><i class="fas fa-users"></i> 2 clases grupales/semana</li>
                </ul>
                <a href="#contact" class="btn btn-outline">Seleccionar Plan</a>
            </div>

            <div class="pricing-card featured">
                <div class="badge">POPULAR</div>
                <h3>Premium</h3>
                <div class="price">
                    <span class="amount">$69</span>
                    <span class="period">/mes</span>
                </div>
                <ul class="features">
                    <li><i class="fas fa-clock"></i> Acceso 24/7</li>
                    <li><i class="fas fa-dumbbell"></i> Todas las áreas</li>
                    <li><i class="fas fa-users"></i> Clases grupales ilimitadas</li>
                    <li><i class="fas fa-trophy"></i> Plan nutricional básico</li>
                </ul>
                <a href="#contact" class="btn btn-primary">Seleccionar Plan</a>
            </div>

            <div class="pricing-card">
                <h3>Elite</h3>
                <div class="price">
                    <span class="amount">$99</span>
                    <span class="period">/mes</span>
                </div>
                <ul class="features">
                    <li><i class="fas fa-clock"></i> Acceso 24/7 prioritario</li>
                    <li><i class="fas fa-dumbbell"></i> Entrenador personal 3x/sem</li>
                    <li><i class="fas fa-users"></i> Todas las clases ilimitadas</li>
                    <li><i class="fas fa-trophy"></i> Plan nutricional completo</li>
                </ul>
                <a href="#contact" class="btn btn-outline">Seleccionar Plan</a>
            </div>
        </div>
    </div>
</section>

<!-- Why Choose Us Section -->
<section class="why-us">
    <div class="container">
        <div class="section-header">
            <h2>¿Por Qué Elegirnos?</h2>
            <p>Lo que nos hace diferentes</p>
        </div>
        <div class="why-grid">
            <div class="why-item">
                <i class="fas fa-trophy"></i>
                <h3>Resultados Probados</h3>
                <p>Miles de transformaciones exitosas</p>
            </div>
            <div class="why-item">
                <i class="fas fa-users"></i>
                <h3>Comunidad Activa</h3>
                <p>Entrenamientos motivadores en grupo</p>
            </div>
            <div class="why-item">
                <i class="fas fa-dumbbell"></i>
                <h3>Equipo Premium</h3>
                <p>Tecnología de última generación</p>
            </div>
            <div class="why-item">
                <i class="fas fa-clock"></i>
                <h3>Horarios Flexibles</h3>
                <p>Abierto 24/7 para tu comodidad</p>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section class="contact" id="contact">
    <div class="container">
        <h2>¡Comienza Hoy!</h2>
        <p class="contact-subtitle">Visítanos o contáctanos para más información</p>
        <div class="contact-grid">
            <div class="contact-item">
                <i class="fas fa-map-marker-alt"></i>
                <h3>Ubicación</h3>
                <p>Av. Principal 123<br>Ciudad, País</p>
            </div>
            <div class="contact-item">
                <i class="fas fa-phone"></i>
                <h3>Teléfono</h3>
                <p>+1 (555) 123-4567</p>
            </div>
            <div class="contact-item">
                <i class="fas fa-envelope"></i>
                <h3>Email</h3>
                <p>info@tugym.com</p>
            </div>
        </div>
        <a href="#contact" class="btn btn-primary btn-large">Agenda tu Clase de Prueba</a>
    </div>
</section>