@model IEnumerable<GA_GymAssistant_.Models.IAConsulta>
@{
    Layout = null;
    var historial = ViewBag.Historial as List<GA_GymAssistant_.Models.Conversacion>;
    var currentChatId = ViewBag.ChatActualId as int?;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Entrenador IA | Gym Assistant</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style>
        /* Scrollbar personalizada */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #1f2937; }
        ::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #6b7280; }

        .fade-in { animation: fadeIn 0.3s ease-in-out; }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Estilos de Tabla */
        .rutina-content table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            margin-bottom: 10px;
            background-color: #1f2937;
            border-radius: 8px;
            overflow: hidden;
            font-size: 0.9rem;
        }
        .rutina-content th {
            background-color: #4f46e5;
            color: white;
            padding: 10px;
            text-align: left;
            font-weight: 600;
        }
        .rutina-content td {
            padding: 10px;
            border-bottom: 1px solid #374151;
            color: #d1d5db;
        }
        .rutina-content tr:last-child td { border-bottom: none; }
       /* ... tus otros estilos ... */

    /* ESTILOS PARA IMPRESIÓN PDF (Modo Nuclear: Forzar todo a negro) */
    .pdf-mode {
        background-color: #ffffff !important;
        padding: 40px !important;
        font-family: sans-serif !important;
    }

    /* Forzar que TODO el texto dentro del PDF sea negro */
    .pdf-mode * {
        color: #000000 !important;
        border-color: #000000 !important;
    }

    .pdf-mode table {
        width: 100% !important;
        border-collapse: collapse !important;
        background-color: #ffffff !important;
        color: #000000 !important;
        margin-top: 20px !important;
    }

    .pdf-mode th {
        background-color: #e5e7eb !important; /* Gris muy claro para encabezado */
        color: #000000 !important;
        border: 1px solid #000000 !important;
        font-weight: bold !important;
        padding: 12px !important;
        text-transform: uppercase !important;
        font-size: 12px !important;
    }

    .pdf-mode td {
        background-color: #ffffff !important;
        color: #000000 !important;
        border: 1px solid #000000 !important; /* Borde negro sólido */
        padding: 10px !important;
        font-size: 11px !important;
    }

    /* Título del PDF */
    .pdf-header {
        text-align: center;
        margin-bottom: 20px;
        color: #000000 !important;
    }
    .pdf-header h2 { font-size: 24px; font-weight: bold; margin: 0; }
    .pdf-header p { font-size: 14px; color: #444; }
    </style>
</head>
<body class="bg-gray-900 text-gray-100 font-sans overflow-hidden flex h-screen">

    <aside class="w-72 bg-[#0f1117] flex flex-col border-r border-gray-800 hidden md:flex z-20">
        <div class="p-4">
            <form asp-action="NuevaConversacion" method="post">
                <button type="submit" class="w-full bg-gray-800 hover:bg-gray-700 text-gray-300 font-medium py-3 px-4 rounded-full flex items-center gap-3 transition shadow-sm border border-gray-700 group">
                    <div class="bg-gray-700 p-1 rounded-full group-hover:bg-gray-600"><i class="fa-solid fa-plus text-xs"></i></div>
                    <span>Nueva conversación</span>
                </button>
            </form>
        </div>

        <div class="flex-1 overflow-y-auto px-2 space-y-1 py-2">
            <div class="px-4 py-2 text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Tus Chats</div>
            @if (historial != null && historial.Any())
            {
                foreach (var chat in historial)
                {
                    <div class="group relative flex items-center justify-between px-3 py-2 mb-1 rounded-lg transition @(currentChatId == chat.IdConversacion ? "bg-indigo-900/40 border-l-4 border-indigo-500" : "hover:bg-gray-800")">
                        <a href="@Url.Action("Index", new { idConversacion = chat.IdConversacion })" class="flex-1 flex items-center gap-3 text-sm truncate mr-2 @(currentChatId == chat.IdConversacion ? "text-indigo-200 font-medium" : "text-gray-400 group-hover:text-gray-200")" title="@chat.Titulo">
                            <i class="fa-regular fa-message text-xs"></i>
                            <span class="truncate">@chat.Titulo</span>
                        </a>
                        <div class="relative group/menu">
                            <button class="text-gray-500 hover:text-white opacity-0 group-hover:opacity-100 transition px-2 focus:opacity-100"><i class="fa-solid fa-ellipsis"></i></button>
                            <div class="absolute right-0 top-6 hidden group-hover/menu:block w-28 bg-[#1f2937] border border-gray-700 rounded-lg shadow-xl z-50 overflow-hidden">
                                <form asp-action="BorrarConversacion" method="post" onsubmit="return confirm('¿Eliminar este chat permanentemente?');">
                                    <input type="hidden" name="idConversacion" value="@chat.IdConversacion" />
                                    <button type="submit" class="flex items-center gap-2 w-full text-left px-3 py-2 text-xs text-red-400 hover:bg-gray-700 hover:text-red-300 transition">
                                        <i class="fa-solid fa-trash-can"></i> Eliminar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-gray-600 text-xs p-4">No hay historial aún.</div>
            }
        </div>

        <div class="p-4 border-t border-gray-800 bg-[#0f1117]">
             <div class="flex items-center justify-between p-2 rounded-lg hover:bg-gray-800 transition group">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-xs font-bold text-white shadow-lg">
                        @User.Identity.Name?.Substring(0, 1).ToUpper()
                    </div>
                    <div class="flex flex-col">
                        <span class="text-sm font-medium text-gray-200">@User.Identity.Name</span>
                        <span class="text-[10px] text-green-500">● En línea</span>
                    </div>
                </div>
                 <form asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit" title="Cerrar Sesión" class="text-gray-500 hover:text-red-400 transition">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <main class="flex-1 flex flex-col bg-gray-900 h-full relative overflow-hidden">
        
        <div class="md:hidden p-4 border-b border-gray-800 flex justify-between items-center bg-[#0f1117] flex-shrink-0">
            <h1 class="font-bold flex items-center gap-2"><i class="fa-solid fa-dumbbell text-indigo-500"></i> Gym AI</h1>
            <form asp-action="NuevaConversacion" method="post">
                <button type="submit" class="text-indigo-400"><i class="fa-solid fa-plus-circle text-xl"></i></button>
            </form>
        </div>

        <div id="chat-box" class="flex-1 overflow-y-auto p-4 md:p-10 space-y-8 scroll-smooth">
            @if (Model != null && Model.Any())
            {
                foreach (var msg in Model)
                {
                    <div class="flex justify-end fade-in">
                        <div class="bg-[#2d3748] text-gray-100 px-6 py-4 rounded-2xl rounded-tr-sm max-w-2xl shadow-md border border-gray-700">
                            <p class="text-sm md:text-base leading-relaxed">@msg.Pregunta</p>
                        </div>
                    </div>

                    <div class="flex justify-start gap-4 fade-in">
                        <div class="w-8 h-8 rounded-full bg-indigo-600 flex-shrink-0 flex items-center justify-center shadow-lg shadow-indigo-500/20 mt-1">
                            <i class="fa-solid fa-robot text-white text-xs"></i>
                        </div>
                        
                        <div class="flex flex-col w-full max-w-3xl">
                            <div class="text-gray-300 leading-relaxed text-sm md:text-base rutina-content">
    @Html.Raw(msg.Respuesta)
</div>

                            @if (msg.Respuesta.Contains("<table"))
                            {
                                <div class="mt-3">
                                    <button onclick="descargarPDF(this)" class="flex items-center gap-2 bg-red-600 hover:bg-red-500 text-white text-xs font-bold py-2 px-4 rounded-full transition shadow-lg transform hover:scale-105">
                                        <i class="fa-solid fa-file-pdf"></i> Descargar Rutina PDF
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                 <div class="h-full flex flex-col items-center justify-center text-center opacity-90 fade-in pb-20">
                    <div class="w-20 h-20 bg-gray-800 rounded-3xl flex items-center justify-center mb-6 shadow-2xl border border-gray-700 rotate-6 transition hover:rotate-0">
                        <i class="fa-solid fa-brain text-4xl text-indigo-400"></i>
                    </div>
                    <h2 class="text-3xl md:text-4xl font-bold mb-3 text-white">Hola, @User.Identity.Name</h2>
                    <p class="text-gray-400 text-lg mb-8 max-w-md">Soy tu entrenador personal. ¿En qué trabajamos hoy?</p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full max-w-2xl px-6">
                        <button onclick="enviarTexto('Dame una rutina de fuerza de 4 días')" class="p-4 bg-gray-800 hover:bg-gray-700 border border-gray-700 hover:border-indigo-500 rounded-xl text-left transition group">
                            <span class="block text-indigo-400 font-bold mb-1 group-hover:text-indigo-300">🏋️ Rutina de Fuerza</span>
                            <span class="text-gray-500 text-xs group-hover:text-gray-300">Plan de 4 días para hipertrofia</span>
                        </button>
                         <button onclick="enviarTexto('¿Qué comer para perder grasa?')" class="p-4 bg-gray-800 hover:bg-gray-700 border border-gray-700 hover:border-indigo-500 rounded-xl text-left transition group">
                            <span class="block text-green-400 font-bold mb-1 group-hover:text-green-300">🥗 Nutrición</span>
                            <span class="text-gray-500 text-xs group-hover:text-gray-300">Consejos para déficit calórico</span>
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="w-full bg-gray-900 border-t border-gray-800 pt-4 pb-6 px-4 flex-shrink-0 z-10">
            <div class="max-w-3xl mx-auto">
                <form asp-action="Consultar" method="post" id="chatForm" class="relative group">
                    <input type="hidden" name="idConversacion" value="@currentChatId" />
                    <input id="input-pregunta" name="pregunta" autocomplete="off" required
                           class="w-full bg-[#1f2937] text-white rounded-full py-4 pl-6 pr-14 focus:outline-none focus:ring-2 focus:ring-indigo-500 border border-gray-700 placeholder-gray-500 shadow-xl transition-all"
                           placeholder="Escribe tu consulta sobre fitness..." />
                    <button type="submit" id="btn-enviar" class="absolute right-2 top-2 p-2 bg-indigo-600 rounded-full hover:bg-indigo-500 text-white transition disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fa-solid fa-arrow-up"></i>
                    </button>
                </form>
                <p class="text-center text-[10px] text-gray-600 mt-3">
                    Gym Assistant IA puede cometer errores. Consulta siempre a un profesional.
                </p>
            </div>
        </div>
    </main>

   <script>
    window.onload = function() { scrollToBottom(); };

    function scrollToBottom() {
        var chatBox = document.getElementById("chat-box");
        if(chatBox) chatBox.scrollTop = chatBox.scrollHeight;
    }

    function enviarTexto(texto) {
        document.getElementById('input-pregunta').value = texto;
    }

    document.getElementById('chatForm').addEventListener('submit', function() {
        var btn = document.getElementById('btn-enviar');
        var input = document.getElementById('input-pregunta');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        btn.disabled = true;
        input.readonly = true;
    });

  // --- FUNCIÓN DE PDF CORREGIDA (SOLUCIÓN TEXTO INVISIBLE) ---
    function descargarPDF(btn) {
        // 1. Buscamos el contenedor del mensaje
        var parentDiv = btn.closest('.flex-col');
        var contentDiv = parentDiv.querySelector('.rutina-content');

        // 2. Buscamos SOLAMENTE la tabla
        var tableElement = contentDiv.querySelector('table');

        if (tableElement) {
            // Clonamos la tabla para no afectar el chat
            var clone = tableElement.cloneNode(true);
            
            // 3. Eliminamos cualquier clase de Tailwind que pueda causar conflicto de colores
            // (Esto borra clases como 'text-gray-300', etc.)
            clone.querySelectorAll('*').forEach(el => {
                el.className = ''; // Limpiamos clases
            });

            // 4. Creamos un contenedor bonito para el PDF
            var wrapper = document.createElement('div');
            wrapper.innerHTML = `
                <div class="pdf-header">
                    <h2>PLAN DE ENTRENAMIENTO</h2>
                    <p>Generado por GymAssistant AI</p>
                </div>
            `;
            wrapper.appendChild(clone);
            
            // Aplicamos la clase "Nuclear" para forzar estilos de impresión
            wrapper.classList.add('pdf-mode'); 
            
            var opt = {
                margin:       [0.5, 0.5],
                filename:     'Mi_Rutina_GymAssistant.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true, logging: true }, 
                jsPDF:        { unit: 'in', format: 'letter', orientation: 'landscape' }
            };

            // Generamos el PDF
            html2pdf().set(opt).from(wrapper).save();
        } else {
            alert("No se encontró una tabla válida para exportar.");
        }
    }
</script>
</body>
</html>