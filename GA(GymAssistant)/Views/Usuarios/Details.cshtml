@model GA_GymAssistant_.Models.Usuario

@{
    ViewData["Title"] = "Perfil de Usuario";
}

<div class="container py-4">
    <div class="card shadow border-0 mb-4 overflow-hidden">
        <div class="card-body bg-white p-4">
            <div class="d-flex align-items-center">
                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-4 border" 
                     style="width: 80px; height: 80px; font-size: 2rem;">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                         <img src="@Model.AvatarUrl" class="w-100 h-100 rounded-circle" style="object-fit:cover" />
                    }
                    else
                    {
                        <span class="text-secondary fw-bold">@Model.Nombre.Substring(0,1)</span>
                    }
                </div>
                <<div class="flex-grow-1">
    <h2 class="fw-bold mb-0">@Model.Nombre</h2>
    <p class="text-muted mb-1">@Model.Email</p>

    @if(Model.TipoUsuario == "Admin"){
        <span class="badge bg-dark me-1">Administrador</span>
    } else {
        <span class="badge bg-secondary me-1">Cliente</span>
    }

    @if (Model.Estado)
    {
        <span class="badge bg-success">Activo</span>
    }
    else
    {
        <span class="badge bg-danger">Inactivo (Baja)</span>
    }
</div>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.IdUsuario" class="btn btn-warning shadow-sm">
                        <i class="bi bi-pencil"></i> Editar Perfil
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light fw-bold">Datos Biométricos</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Edad</span>
                            <span class="fw-bold">@(Model.Edad.HasValue ? Model.Edad + " años" : "--")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Peso Actual</span>
                            <span class="fw-bold">@(Model.Peso.HasValue ? Model.Peso + " kg" : "--")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Altura</span>
                            <span class="fw-bold">@(Model.Altura.HasValue ? Model.Altura + " m" : "--")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light fw-bold">Perfil Deportivo</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Nivel</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Nivel</dd>

                        <dt class="col-sm-4 text-muted">Objetivo</dt>
                        <dd class="col-sm-8">@Model.Objetivo</dd>

                        <dt class="col-sm-4 text-muted">Zona Meta</dt>
                        <dd class="col-sm-8">@Model.ZonaObjetivo</dd>

                        <dt class="col-sm-4 text-muted">Lesiones</dt>
                        <dd class="col-sm-8 text-danger">
                            @(string.IsNullOrEmpty(Model.Lesiones) ? "Ninguna reportada" : Model.Lesiones)
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-2">
        <a asp-action="Index" class="btn btn-outline-secondary">← Volver al listado</a>
    </div>
</div>